{
  "schemaVersion": "1.1",
  "project": {
    "name": "RDP Manager Workspace",
    "theme": "cyberpunk"
  },
  "storage": {
    "workspaceRootName": "RDPWorkspace",
    "stateFolderName": "State",
    "downloadsFolderName": "Downloads",
    "minFreeSpaceGB": 10
  },
  "rdp": {
    "port": 3389,
    "serviceName": "TermService",
    "firewallGroupName": "Remote Desktop"
  },
  "telegram": {
    "longPollingTimeoutSeconds": 30,
    "maxRetries": 5,
    "retryBackoffSeconds": 5,
    "commands": {
      "lightweight": ["/ping", "/help"],
      "jobs": ["/status"]
    }
  }
}
