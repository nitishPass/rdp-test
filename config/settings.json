{
  "schemaVersion": "1.5",
  "project": {
    "name": "RDP Manager Workspace",
    "theme": "cyberpunk"
  },
  "storage": {
    "workspaceRootName": "RDPWorkspace",
    "stateFolderName": "State",
    "downloadsFolderName": "Downloads",
    "minFreeSpaceGB": 10
  },
  "rdp": {
    "port": 3389,
    "serviceName": "TermService",
    "firewallGroupName": "Remote Desktop"
  },
  "jobManager": {
    "maxWorkers": 2,
    "stateFileName": "jobs.json"
  },
  "aria2": {
    "rpcPort": 6800,
    "maxConcurrent": 2,
    "split": 8,
    "progressUpdateSeconds": 8
  },
  "relay": {
    "autoRelayMinutes": 340,
    "cloudDriveName": "CloudVault"
  },
  "telegram": {
    "longPollingTimeoutSeconds": 30,
    "maxRetries": 5,
    "dashboardRefreshSeconds": 10,
    "commands": {
      "lightweight": ["/ping", "/help", "/jobs", "/status", "/downloads", "/workspace"],
      "jobs": ["/diagnostics", "/testjob", "/download", "/backup", "/relay"]
    }
  }
}
